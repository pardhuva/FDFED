body {
  font-family: Arial, sans-serif;
  background: #f4f4f4;
  display: flex;
  justify-content: center;
  padding-top: 40px;
}

.container {
  background: white;
  padding: 30px;
  border-radius: 10px;
  width: 400px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h1, h2, h3 {
  text-align: center;
}

input {
  width: 60%;
  padding: 10px;
  margin-right: 5px;
}

button {
  padding: 10px 15px;
  margin-top: 10px;
  cursor: pointer;
}

button:hover {
  background-color: #007bff;
  color: white;
}

.messages {
  margin-top: 15px;
  height: 20px;
  text-align: center;
  font-weight: bold;
}

.success {
  color: green;
}

.error {
  color: red;
}

.history {
  margin-top: 20px;
}

ul {
  list-style: none;
  padding-left: 0;
}